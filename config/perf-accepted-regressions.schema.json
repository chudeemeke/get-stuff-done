{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 43 paired performance accepted regressions",
  "description": "Reviewed acceptances consumed by check-perf.js --accepted for the blocking paired path. Policy lives in the candidate checkout so every acceptance is a visible, reviewable PR diff; measurements stay bound to the pinned harness. Entries are platform+metric scoped, ratio-bounded, and expiring - there is no global scope and no open-ended acceptance.",
  "type": "object",
  "required": ["schemaVersion", "acceptances"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "acceptances": {
      "type": "array",
      "items": { "$ref": "#/definitions/acceptance" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "acceptance": {
      "type": "object",
      "required": ["platform", "metric", "maxRatio", "reason", "reviewer", "reviewedDate", "ticket", "expiresOn"],
      "properties": {
        "platform": { "type": "string", "enum": ["linux", "macos", "windows"] },
        "metric": { "type": "string", "enum": ["install", "compose"] },
        "maxRatio": { "type": "number", "exclusiveMinimum": 1.25 },
        "reason": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "ticket": { "type": "string", "minLength": 1 },
        "expiresOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      },
      "additionalProperties": false
    }
  }
}
