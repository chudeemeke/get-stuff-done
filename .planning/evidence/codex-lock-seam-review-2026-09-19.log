 439: function applied(overrides = {}) {
 440:   return {
 441:     kind: 'applied',
 442:     preImageTime: '2026-09-19T03:00:00.000Z',
 443:     topLevel: { appeared: [], disappeared: [] },
 444:     quarantine: { path: QUARANTINE, newUnits: 0, newFiles: 0, displaced: [], movedList: `${QUARANTINE}/moved.txt` },
 445:     ...overrides,
 446:   };
 447: }
 448: 
 449: function incomplete(overrides = {}) {
 450:   return { kind: 'incomplete', problems: [{ path: 'agents/a.md', reason: 'EBUSY' }], retiredPath: RETIRED, quarantine: applied().quarantine, ...overrides };
 451: }
 452: 
 453: function recovered(result) {
 454:   return { kind: 'recovered', interruptedAt: '2026-09-19T02:40:00.000Z', result };
 455: }
