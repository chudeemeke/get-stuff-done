 239: // --- the takeover race: a rename is not a compare-and-swap, so every interleaving with a
 240: // rival installer must end with at most one run holding the lock, and the loser refusing.
 241: 
 242: const DEAD = { pid: 4242, created: '2026-09-18T01:00:00.000Z' };
 243: const RIVAL = { pid: 2222, created: '2026-09-19T02:59:59.000Z' };
 244: const THIRD = { pid: 3333, created: '2026-09-19T02:59:59.500Z' };
 245: // apiWith() names every file it makes after its one id.
 246: const CLAIM = `${LOCK}.stale-tx-0001`;
 247: const PENDING = `${CLAIM}.new`;
 248: 
 249: // The real filesystem with some calls replaced: a fault, or a rival acting first.
 250: function fsWith(overrides) {
 251:   return new Proxy(fs, { get: (real, name) => overrides[name] || real[name] });
 252: }
 253: 
 254: function readLockFile(target) {
 255:   return JSON.parse(fs.readFileSync(path.join(target, LOCK), 'utf8'));
 256: }
 257: 
 258: function assertChangedHands(error, target) {
 259:   assert.equal(error.name, 'InstallRefusal');
 260:   assert.equal(error.exitCode, 6);
 261:   assert.equal(error.message, `The install lock changed hands while this run was starting (lock ${path.join(target, LOCK)}). `
 262:     + 'Run again. If it still refuses and no installer is running, delete that file and run again.');
 263: }
