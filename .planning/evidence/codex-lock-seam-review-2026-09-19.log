 269:   const error = refusalOf(() => apiWith({ fs: fsWith({
 270:     renameSync: (from, to) => {
 271:       fs.renameSync(from, rivalClaim);
 272:       return fs.renameSync(from, to);
 273:     },
 274:   }) }).acquireLock(target));
 275:   assertChangedHands(error, target);
 276:   assert.deepEqual(fs.readdirSync(target), [path.basename(rivalClaim)]);
 277:   assert.deepEqual(JSON.parse(fs.readFileSync(rivalClaim, 'utf8')), DEAD);
 278: });
